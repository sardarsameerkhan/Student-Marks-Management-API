            "url": "{{baseUrl}}/api/courses/{{courseId}}"
          }
        },
        {
          "name": "Unknown Course",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/courses/2147483647" }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Transcript Report",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/students/{{seedStudentId}}/transcript" }
        },
        {
          "name": "Course Stats Report",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/courses/{{seedCourseId}}/stats" }
        }
      ]
    },
    {
      "name": "Enrollments and Marks",
      "item": [
        {
          "name": "Enroll Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"studentId\":{{studentId}}}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/courses/{{courseId}}/enrollments"
          }
        },
        {
          "name": "Duplicate Enrollment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"studentId\":{{studentId}}}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/courses/{{courseId}}/enrollments"
          }
        },
        {
